{
  "name": "xiaodao-flowchart",
  "version": "0.1.1",
  "description": "A Vue 3 component for flowchart drawing",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "flowchart",
    "drawing"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/xiaodao-flowchart.umd.cjs",
  "module": "./dist/xiaodao-flowchart.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/xiaodao-flowchart.es.js",
      "require": "./dist/xiaodao-flowchart.umd.cjs"
    },
    "./style.css": "./dist/xiaodao-flowchart.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build && vue-tsc --emitDeclarationOnly -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "vue": "^3.5.40",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaodaozhi/xiaodao-flowchart.git"
  }
}
